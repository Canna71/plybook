{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. No shell access: engines are started by Rust commands, and the Engines folder is off limits to the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "process:default",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-resource-read-recursive",
    {
      "identifier": "fs:scope",
      "deny": [
        { "path": "$APPLOCALDATA/Engines" },
        { "path": "$APPLOCALDATA/Engines/**" }
      ]
    },
    "dialog:default",
    "clipboard-manager:default",
    "updater:default"
  ]
}
